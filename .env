# DeepSeek API 配置
# 复制此文件为 .env 并填入你的真实 API 密钥

# 必填：你的 DeepSeek API Key
DEEPSEEK_API_KEY= 

# 可选：DeepSeek API 地址（默认即可）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 可选：模型名称（默认 deepseek-v4-pro）
DEEPSEEK_MODEL=deepseek-v4-pro

# Firecrawl 网页搜索 API（智能体联网搜索）
# 免费注册: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=fc-b7983e60cc5e407b8da1422fa5762263
